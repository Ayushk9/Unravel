# Copy this file to .env and replace each placeholder with your local value.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/unravel
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
GEMINI_API_KEY=replace-with-your-gemini-api-key
ENVIRONMENT=local
# Used only when ENVIRONMENT=dev. Matches the web client's fixed development token.
DEV_STUB_TOKEN=mock-household-token
DEV_STUB_HOUSEHOLD_ID=01a043f0-7194-7a1a-8df8-e496869dab10
# Relative paths resolve from the API process working directory.
UPLOAD_DIRECTORY=data/uploads
