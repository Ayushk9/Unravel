# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored. Never commit it.

# The database is a LOCAL PostgreSQL 17 on this Mac (Homebrew, no Docker), with pgvector:
#   brew install postgresql@17 pgvector && brew services start postgresql@17
#   createdb unravel && psql -d unravel -c "CREATE EXTENSION IF NOT EXISTS vector"
# Local "trust" authentication: your macOS user name, no password. Async driver.
DATABASE_URL=postgresql+asyncpg://your-mac-user@localhost:5432/unravel

# Supabase is used ONLY for login keys (the database is local). Project URL,
# e.g. https://abcdefgh.supabase.co (no trailing slash).
# The project signs login tokens with an ECC (P-256) key, so there is no shared
# secret to store: the API downloads the project's PUBLIC keys from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json and verifies tokens with those.
SUPABASE_URL=https://your-project-ref.supabase.co

GEMINI_API_KEY=replace-with-your-gemini-api-key

# Model used to read documents (policy extraction and claim-document
# classification). If uploads start failing and the server log shows a 404
# naming this model, Google has retired it: set the newer name it suggests.
GEMINI_MODEL=gemini-3.8-flash
# Policy Q&A: tried once when GEMINI_MODEL is still busy (503) or out of quota (429) after
# 4 attempts. Free-tier quota is per model, so a second model keeps the demo answering.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Seconds one Gemini call may take: a Q&A call, and a grievance-draft call (a longer output).
# QA_LLM_TIMEOUT_SECONDS=60
# GRIEVANCE_LLM_TIMEOUT_SECONDS=120

# --- Where uploaded files are kept ---------------------------------------
# "local" (default): a folder on this machine. Nothing else to set up.
# "supabase": a private Supabase Storage bucket; needs the two settings below.
STORAGE_BACKEND=local

# Folder for the local backend. Relative paths are taken from apps/api.
# The default folder, apps/api/storage/, is gitignored: it holds real policy
# documents and must never be committed.
LOCAL_STORAGE_DIR=storage

# Only for STORAGE_BACKEND=supabase.
# Supabase -> Settings -> API Keys -> secret key. It bypasses all access
# rules, so it must never reach a browser, a mobile app or git. Create the
# bucket once with: ../../.venv/bin/python scripts/create_bucket.py
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-secret-key
# STORAGE_BUCKET=documents

# --- Network -------------------------------------------------------------
# Used by `python -m app`. 0.0.0.0 listens on every network interface, so
# other devices on the same Wi-Fi can reach the server at
# http://<this Mac's IP>:8000 (find the IP with: ipconfig getifaddr en0).
# Use 127.0.0.1 to accept connections from this machine only.
HOST=0.0.0.0
PORT=8000
#
# Reaching the server from an Android phone on the same Wi-Fi:
#   - The NATIVE Android app is not a browser, so CORS does not apply to it
#     and nothing needs adding below. It does need to be allowed to use plain
#     http:// (Android blocks cleartext by default): set
#     android:usesCleartextTraffic="true", or a network security config that
#     permits the Mac's IP, in the app's debug build.
#   - A BROWSER on the phone opening the web app is subject to CORS. Start
#     Vite with `npm run dev -- --host`, set VITE_API_BASE_URL in apps/web/.env
#     to http://<Mac IP>:8000, and add http://<Mac IP>:5173 to
#     CORS_ALLOWED_ORIGINS below.
#   - macOS may ask whether Python can accept incoming connections: allow it.
#   - While ENVIRONMENT=dev, anyone on that Wi-Fi who knows the stub token can
#     read the seeded household's data. Use a network you trust.

# A parse that runs longer than this is terminated and its job marked failed.
PARSE_TIMEOUT_SECONDS=300

# A claim-document classification still running after this is stopped.
CLASSIFY_TIMEOUT_SECONDS=60

# How many documents may be parsed at the same time. Docling needs a lot of
# memory; keep this at 1 on a small host.
MAX_CONCURRENT_PARSES=1

# Extra browser origins allowed to call the API, comma-separated. Optional.
# http://localhost:5173 (the Vite dev server) is always allowed when
# ENVIRONMENT=dev. Add an entry when the web app is opened from anywhere
# else: Vite on another port (http://localhost:5174), or a phone's browser
# (http://<Mac IP>:5173). An origin is scheme + host + port, exactly as it
# appears in the browser's address bar, with no trailing slash. "*" is ignored.
CORS_ALLOWED_ORIGINS=

# Optional. Database for tests that need real SQL. They create a temporary
# schema, use only that, and drop it afterwards. A separate local database
# (createdb unravel_test, plus CREATE EXTENSION vector) keeps test runs away from
# the dev data. If unset, those tests are skipped.
# TEST_DATABASE_URL=postgresql+asyncpg://your-mac-user@localhost:5432/unravel_test

# dev | test | prod. The stub token is accepted only in dev.
ENVIRONMENT=dev
