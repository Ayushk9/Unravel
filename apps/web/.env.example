# Copy to .env.local for real changes. Defaults below are what the app falls
# back to when no .env file is present at all, so `npm run dev` works out of
# the box in mock mode.

# "mock" starts MSW and ignores VITE_API_BASE_URL entirely.
# "live" talks to VITE_API_BASE_URL for every request — client.ts appends
#   /api/v1 (D-01), MSW never starts.
# "hybrid" starts MSW AND talks to VITE_API_BASE_URL, per request: routes
#   listed in apps/web/src/api/hybridRoutes.ts (HYBRID_LIVE_ROUTES) go live,
#   everything else stays mocked. Edit that array — nothing here — to change
#   which routes are live. The active mode and (in hybrid) the live route
#   list are logged to the console once at startup, dev builds only.
VITE_API_MODE=mock

# Host only, no path. Used when VITE_API_MODE=live or hybrid.
VITE_API_BASE_URL=http://localhost:8000
